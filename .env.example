# Values must be supplied privately by the operator. Never commit a filled copy.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# Use the SAME effective key as existing encrypted settings. Rotation requires a separate plan.
AI_ENCRYPTION_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_MODEL_VERIFIED=false
RAG_EMBEDDING_CALLS_APPROVED=false
RAG_EMBEDDING_API_KEY=
RAG_ENVIRONMENT=development
RAG_DATABASE_APPROVED=false
# Phase4 defaults: no startup worker, no live request, no production activation.
RAG_RUNTIME_MODE=OFFLINE_MOCK
RAG_LOCAL_GEMINI_AUTHORIZED=false
RAG_CHAT_TEST_API_KEY=
RAG_LIVE_PLAN_PATH=
